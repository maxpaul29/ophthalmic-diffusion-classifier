# Large data and checkpoints stay on the host — mounted as volumes at runtime
checkpoints/
dataset/data/

# Generated outputs
experiments/*/plots/
experiments/*/inference_images/
experiments/*/training_images/

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Git history (not needed inside container)
.git/
.gitignore

# Editor / OS noise
.DS_Store
*.swp
*.swo
